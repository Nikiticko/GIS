{
  "name": "gis-production-schedule-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./server/load-env.mjs ./server/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:dev": "node --watch --import ./server/load-env.mjs --import tsx server/index.ts",
    "api:typecheck": "tsc -p server/tsconfig.json",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "api:bootstrap-admin": "node --import ./server/load-env.mjs --import tsx server/bootstrap-admin.ts",
    "db:migrate": "node --import ./server/load-env.mjs --import tsx server/migrate.ts",
    "api:build": "tsc -p server/tsconfig.json --noEmit false --outDir dist-api",
    "api:start": "NODE_ENV=production node --import ./server/load-env.mjs dist-api/index.js",
    "db:migrate:production": "node --import ./server/load-env.mjs dist-api/migrate.js",
    "api:bootstrap-admin:production": "node --import ./server/load-env.mjs dist-api/bootstrap-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
