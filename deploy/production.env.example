DOMAIN=gis.example.com
POSTGRES_PASSWORD=replace_with_random_password
# Пароль у URL має збігатися з POSTGRES_PASSWORD; спеціальні символи кодуються для URL.
DATABASE_URL=postgresql://gis:replace_with_random_password@db:5432/gis
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_BOT_USERNAME=replace_with_bot_username_without_at
TELEGRAM_WEBHOOK_URL=https://gis.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
