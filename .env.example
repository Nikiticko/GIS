# Підключення до PostgreSQL. Для локальної бази можна залишити порожнім:
# файл .local/use-local-db налаштовує локальний сокет автоматично.
# Для іншої бази вкажіть повний URL підключення.
DATABASE_URL=

# Необов'язкові параметри сервера
HOST=127.0.0.1
PORT=3000
LOG_FILE=logs/gis-api.log

# Каталог для нових вкладень об'єктів
ATTACHMENTS_DIR=.local/attachments

# Необов'язкові параметри S3 для доступу до раніше завантажених файлів
# S3_BUCKET=
# AWS_REGION=us-east-1
# S3_ENDPOINT=

# Встановлюється на production за HTTPS
# NODE_ENV=production
# TRUST_PROXY=
